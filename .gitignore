# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-e2e-signer
*.local

# Secret keys. scripts/seed-merchant.mjs generates a merchant and a customer
# identity and writes BOTH SECRET KEYS here in hex, so this file is exactly as
# sensitive as an nsec. It is real key material for whatever those identities
# hold, and it must never be committed.
.seed-keys.json
# The seller's record of who bought a subscription, when it expires, and what
# they have already been told about it. No key material, but it is a list of
# paying customers by pubkey — a customer list, which is precisely the thing
# ADR 0007's design avoids holding server-side. It stays on the seller's own
# machine. Regenerable in the sense that matters: deleting it stops the expiry
# reminders and takes nobody's subscription away, because the entitlement lives
# in the customer's voucher.
.sold-subscriptions.json
# Throwaway customer keys for load runs. Worthless on a test deployment, but
# still keys, and regenerable with `node loadtest/pool.mjs`.
.loadtest-pool.json

# Browser-automation output: console logs, screenshots and traces from headless
# QA runs. Regenerated on every run and 300+ MB after a few sessions.
.playwright-mcp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gstack/
__pycache__/
till.png

# Performance run artifacts. Generated on every run; commit one deliberately
# when it is worth keeping, rather than accumulating every local run.
perf/results/*.json
perf/results/*.md

# Same for the gateway mix, which writes a summary on every run including a
# smoke run against a stub. A run worth keeping is committed by hand, as the
# dated reports in loadtest/results/ already are.
loadtest/results/market-day-summary.json
loadtest/results/checkout-codes-summary.json
loadtest/results/checkout-codes-make-summary.json
# The checkout codes a generation run made, with the shop keys that redeem them. Test keys, but keys.
.loadtest-codes.json

# Screenshots a failed e2e/probe-concurrent-redeem.mts run leaves behind.
e2e/.probe-concurrent-redeem/

# Screenshots a failed e2e/probe-cashback-spend.mts run leaves behind.
e2e/.probe-cashback-spend/

# Local npm cache (npm ci --cache .npm in containers/CI).
.npm
# real-day.mts writes its k6 crowd summary here per run; the dated real-day report is what is kept.
loadtest/results/.real-day-k6-*.json

# Local support-snapshot secrets for ./deploy/up.sh (copy from support-snapshot.env.example).
deploy/support-snapshot.env
.anthropic-key

# docs: only top-level pages are published; sub-folders stay local.
docs/*/

# Local scratch notes and probes.
.scratch/

# Screenshots a failed e2e/receipts-local.e2e.mts run leaves behind.
e2e/.receipts-local/
.paypal
