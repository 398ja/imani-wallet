# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secret keys. scripts/seed-merchant.mjs generates a merchant and a customer
# identity and writes BOTH SECRET KEYS here in hex, so this file is exactly as
# sensitive as an nsec. It is real key material for whatever those identities
# hold, and it must never be committed.
.seed-keys.json

# Browser-automation output: console logs, screenshots and traces from headless
# QA runs. Regenerated on every run and 300+ MB after a few sessions.
.playwright-mcp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gstack/
__pycache__/
till.png

# Performance run artifacts. Generated on every run; commit one deliberately
# when it is worth keeping, rather than accumulating every local run.
perf/results/*.json
perf/results/*.md
