# Copy to deploy/support-snapshot.env (gitignored) to turn on support and fleet
# snapshots in the local stack. ./deploy/up.sh picks it up on its own.
# Variables are documented in imani-deploy's .env.support-snapshot.example.

SUPPORT_BLOSSOM_URL=http://localhost:28090
SUPPORT_BLOSSOM_ALLOWED_HOSTS=localhost:28090
SUPPORT_BLOSSOM_TTL=7d
SUPPORT_BLOSSOM_TTL_HUMAN=7 days

# The wallet origins allowed to upload: Vite dev/preview on 5173, the e2e port 5176.
SUPPORT_SNAPSHOT_ORIGINS=^http://localhost:517[36]$
SUPPORT_WALLET_ORIGIN=http://localhost:5173

SUPPORT_LLM_PROVIDERS=anthropic,openai

# Support's own Nostr key. SUPPORT_NPUB must be the npub of SUPPORT_NOSTR_NSEC.
#   npx nak key generate  |  npx nak key public <hex>  |  npx nak encode nsec/npub
SUPPORT_NOSTR_NSEC=
SUPPORT_NPUB=

# Seals each snapshot's keys in the ledger: openssl rand -hex 32
SUPPORT_LEDGER_KEY=

# Fleet snapshots (#591). Leave false for support snapshots only. For fast local
# rounds set it true and shorten the FLEET_* timings (see imani-deploy's example).
SUPPORT_FLEET_ENABLED=false
