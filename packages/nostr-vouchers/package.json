{
  "name": "@imani/nostr-vouchers",
  "version": "0.1.1",
  "description": "Voucher management library for Nostr with local storage, filtering, grouping, and relay sync",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./database": {
      "import": {
        "types": "./dist/database/index.d.ts",
        "default": "./dist/database/index.js"
      },
      "require": {
        "types": "./dist/database/index.d.cts",
        "default": "./dist/database/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nostr",
    "vouchers",
    "wallet",
    "cashu",
    "indexeddb",
    "ecash",
    "gift-cards"
  ],
  "author": "Imani",
  "license": "MIT",
  "dependencies": {
    "@imani/money": "file:../money",
    "nostr-tools": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.55.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "nostr-tools": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
