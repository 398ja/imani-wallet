{
  "name": "imani-qr",
  "version": "0.5.1",
  "description": "QR detection, scanning, and NUT-16 animated transport utilities for the Imani wallet",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "qr",
    "cashu",
    "nostr",
    "imani"
  ],
  "author": "Imani",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@gandlaf21/bc-ur": "^1.1.12",
    "buffer": "^6.0.3",
    "qr-scanner": "^1.4.2"
  }
}
