{
  "name": "@imani/money",
  "version": "0.2.0",
  "description": "Currency registry and safe money arithmetic for Imani apps",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "imani",
    "money",
    "currency",
    "arithmetic",
    "bitcoin",
    "cashu"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArcadeLabsInc/imani-apps.git",
    "directory": "packages/money"
  }
}
