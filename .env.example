# Build-time settings for the wallet, read through `import.meta.env`.
#
# Copy to `.env.local` (gitignored) for `npm run dev` / `npm run build`. The
# image takes the same names as Dockerfile build args (`--build-arg NAME=value`),
# and imani-deploy's scripts/deploy-staging.sh and build-beta.sh pass them per
# environment. Every VITE_* value is compiled into the bundle the browser loads:
# NONE of these is a secret, and none may ever be one.

# The public website, no trailing path. New accounts accept the Terms and
# Conditions at <this>/terms.html (#357). REQUIRED: the image build fails
# without it (scripts/check-website-base-url-build.sh), and a bundle built
# without it refuses to create accounts rather than link to a missing page.
VITE_WEBSITE_BASE_URL=https://www.imani.casa

# The relay browsers connect to, and the one the server-side services use
# (src/lib/relay.ts). Unset: ws://localhost:27778 and ws://nostr-relay:7777.
VITE_RELAY_URL=ws://localhost:27778
VITE_INTERNAL_RELAY_URL=ws://nostr-relay:7777

# The mints this build credits coupons from, comma-separated public mint URLs
# (src/lib/trustedMint.ts). REQUIRED by the image build (#133).
VITE_TRUSTED_MINT_URLS=
# Dev only: credit coupons from any mint. Ignored in a production build.
VITE_ALLOW_ANY_MINT_IN_DEV=

# Keys that sign vouchers this build believes, comma-separated 64-hex
# (src/lib/issuerAllowlist.ts). Empty: no terminal opens.
VITE_VOUCHER_ISSUER_PUBKEYS=

# The licence issuer and seller stall keys, 64-hex (src/lib/licenceStatus.ts).
VITE_LICENCE_ISSUER_PUBKEY=
VITE_LICENCE_SELLER_PUBKEY=

# Sister sites the wallet opens and signs in (#411, NAP extension 0002; src/lib/sisterSites.ts).
# Per environment, never in code: Settings › Subscription › "Upgrade my plan" opens
# VITE_SUBSCRIPTION_SITE_URL, and each site may obtain a NAP login ONLY for its own origin.
# Empty: that site is not part of this deployment (the button says so, nothing is signed for it).
#   local:      http://localhost:18910 (deploy/subscription-local)
#   production: https://subscription.imani.casa, https://gifting.imani.casa
VITE_SUBSCRIPTION_SITE_URL=
VITE_GIFTING_SITE_URL=

# Google Drive backup: the OAuth WEB client id (src/lib/drive.ts). Public.
# Empty: the Drive buttons say "not set up".
VITE_GOOGLE_CLIENT_ID=

# Map tiles template, used when the gateway names none (src/lib/osmTiles.ts).
VITE_MAP_TILE_URL=

# Checkout codes at a stall's online shop (#402). `on` to show "Use online"; off ships it dark.
VITE_CHECKOUT_CODES=
