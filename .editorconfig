# EditorConfig configuration for Imani Wallet
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_import-ordering = disabled

[*.{yml,yaml}]
indent_size = 2

[*.{json,md}]
max_line_length = off

[*.md]
trim_trailing_whitespace = false

[{gradlew,gradlew.bat}]
indent_size = unset
insert_final_newline = unset
