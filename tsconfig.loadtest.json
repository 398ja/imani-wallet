{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.loadtest.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["loadtest/real-day.mts", "loadtest/real-day/**/*.mts", "e2e/lib/**/*.mts", "e2e/postdeploy-staging.e2e.mts"]
}
