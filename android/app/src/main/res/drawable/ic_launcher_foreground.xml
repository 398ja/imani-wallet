<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon foreground (imani-wallet#558): the Imani mark from public/imani.svg, the same
  rounded path as the splash (drawable/imani_mark.xml) and the web app icon.

  An adaptive icon is 108dp, and launchers mask it to a circle, squircle or square that keeps only
  the centre 66dp. The 48-unit artwork is drawn into a 108-unit viewport at scale 1.3, so it spans
  62.4 units (31.2 to 77.4 on both axes), inside that safe zone on every mask.

  The colour is fixed, not @color/splash_mark: launcher icons do not follow the night theme, and
  the background (ic_launcher_background) is the app's light background #fafafa.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.3"
        android:scaleY="1.3"
        android:translateX="22.8"
        android:translateY="22.8">
        <path
            android:fillColor="#171717"
            android:fillType="evenOdd"
            android:pathData="M10 2 H24 A8 8 0 0 1 32 10 V24 A8 8 0 0 1 24 32 H10 A8 8 0 0 1 2 24 V10 A8 8 0 0 1 10 2 Z M24 16 H38 A8 8 0 0 1 46 24 V38 A8 8 0 0 1 38 46 H24 A8 8 0 0 1 16 38 V24 A8 8 0 0 1 24 16 Z" />
    </group>
</vector>
